# Server-side settings for online ordering. NEVER commit real values.
# Enter real values only in the hosting dashboard (Cloudflare Pages → Settings → Variables and Secrets).
# For local testing of functions with Wrangler, copy to .dev.vars (git-ignored).
# See server/README.md and docs/ACTIVATION-CHECKLIST.md.

# The live site address, e.g. https://www.restaurant.com
SITE_URL=

# Order notifications: at least one channel
ORDER_WEBHOOK_URL=
RESEND_API_KEY=
ORDER_EMAIL_TO=
ORDER_EMAIL_FROM=

# Online payment (only with payment.type = 'checkout-redirect')
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
